# 8. LIVE MODE
# ==========================================
def run_live(cfg):
    ex_class = getattr(ccxt, cfg["exchange"])
    ex = ex_class({"enableRateLimit": True, "options": {"defaultType": cfg["market_type"]}})

    symbols = get_top_coins(ex, cfg)
    state = load_state()

    for symbol in symbols:
        try:
            # 15m Base candle fetch
            df15 = fetch_ohlcv_df(ex, symbol, "15m", cfg["candles_to_fetch"])
        except Exception:
            continue

        # Check 15m
        check_one(df15, symbol, "15m", cfg, state, f"{symbol}_15m")

        # Check 30m
        try:
            df30 = fetch_ohlcv_df(ex, symbol, "30m", cfg["candles_to_fetch"])
            check_one(df30, symbol, "30m", cfg, state, f"{symbol}_30m")
        except Exception:
            pass

        # Check 45m (resampled from 15m)
        if cfg["also_build_45m"]:
            df45 = resample_to_45m(df15)
            check_one(df45, symbol, "45m", cfg, state, f"{symbol}_45m")

        # Check 60m (1h)
        try:
            df60 = fetch_ohlcv_df(ex, symbol, "1h", cfg["candles_to_fetch"])
            check_one(df60, symbol, "1h", cfg, state, f"{symbol}_1h")
        except Exception:
            pass

    save_state(state)

